/* Test bool operators */

bool dontCallMe(int x) {
  print(x);
  return True;
}

bool implies(bool x, bool y) {
  return not x or x == y;
}

int main () {
  int x = 4;
  if (3 <= x and 4 <> 2 and True) {
    print(True);
  } else {
    print("apa");
  }

  print(True == True or dontCallMe(1));
  print(4 < -5 and dontCallMe(2));

  print(4 == x and True == not False and True);

  print(implies(False,False));
  print(implies(False,True));
  print(implies(True,False));
  print(implies(True,True));
  return 0;
}
